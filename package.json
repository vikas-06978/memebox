{
  "name": "memebox",
  "version": "1.3.1",
  "private": true,
  "description": "MemeBox: meme soundboard & voice changer for browser video calls (Chrome MV3 extension + Cloudflare Pages site).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build": "node tools/sync-fx.mjs && node tools/build.mjs",
    "build:release": "node tools/sync-fx.mjs && node tools/build.mjs --release",
    "zip": "node tools/zip.mjs",
    "vendor": "node tools/vendor-espeak.mjs",
    "icons": "node tools/make-icons.mjs",
    "version:set": "node tools/version.mjs",
    "site:dev": "node tools/site-dev.mjs",
    "store-images": "node tools/store-images.mjs",
    "demo-sounds": "node tools/make-demo-sounds.mjs",
    "seo": "node tools/seo.mjs",
    "tutorial": "node tools/make-product-tour.mjs",
    "sync-fx": "node tools/sync-fx.mjs",
    "review:build": "npm run build:release && node tools/build-review.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2"
  }
}
