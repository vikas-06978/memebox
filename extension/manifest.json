{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.7.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen",
    "tabCapture"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/wc/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*"
      ],
      "js": [
        "lib/pitch-shift.js",
        "mic-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/wc/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*"
      ],
      "js": [
        "config.js",
        "lib/plan.js",
        "defaults.js",
        "bridge.js",
        "ui.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "fav-1": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "__MSG_cmdFav1__"
    },
    "fav-2": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "__MSG_cmdFav2__"
    },
    "fav-3": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "__MSG_cmdFav3__"
    },
    "stop-all": {
      "suggested_key": {
        "default": "Alt+0"
      },
      "description": "__MSG_cmdStopAll__"
    },
    "fav-4": {
      "description": "__MSG_cmdFav4__"
    },
    "fav-5": {
      "description": "__MSG_cmdFav5__"
    },
    "fav-6": {
      "description": "__MSG_cmdFav6__"
    },
    "fav-7": {
      "description": "__MSG_cmdFav7__"
    },
    "fav-8": {
      "description": "__MSG_cmdFav8__"
    },
    "fav-9": {
      "description": "__MSG_cmdFav9__"
    },
    "toggle-ui": {
      "description": "__MSG_cmdToggleUi__"
    },
    "toggle-voice": {
      "description": "__MSG_cmdToggleVoice__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "voice-worklet.js",
        "lib/pitch-shift.js"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://app.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
